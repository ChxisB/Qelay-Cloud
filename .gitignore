node_modules/
dist/
*.local
.DS_Store
.env
.env.*
!.env.example

# Build/test noise
*.tsbuildinfo
coverage/

# bun.lock IS committed on purpose: CI uses `bun install --frozen-lockfile`.

# Terraform: never commit state or provider caches
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
*.tfplan

# Debug logs from bun, npm and friends
*.log

# Claude Code local state and the agent's working notes. Only .claude/skills/ is committed.
.claude/worktrees/
.claude/settings.local.json
.claude/.planning/
.claude/completions/
.claude/sessions/

# Throwaway TLS certificate exported by the postgres-tls compose service
test/support/pgbouncer/.tls/

# Playwright output
test-results/
playwright-report/
