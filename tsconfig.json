{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["bun-types"],

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/store-postgres" },
    { "path": "packages/transport-local" },
    { "path": "packages/transport-gcp" },
    { "path": "packages/transport-aws" },
    { "path": "packages/transports" },
    { "path": "packages/sdk" },
    { "path": "packages/maintenance" },
    { "path": "packages/telemetry" },
    { "path": "packages/control-api" }
  ]
}
